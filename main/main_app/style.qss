/* --- 1. HÁTTEREK ÉS ÁTLÁTSZÓ OLDALAK --- */
QWidget#centralwidget {
    border-image: url("assets/bg.png") 0 0 0 0 stretch stretch;
    background-color: #121018;
}

QStackedWidget,
QWidget#page0_fomenu,
QWidget#page1_terkep,
QWidget#page2_soteterdo,
QWidget#page3_karakter,
QWidget#page5_auth,
QWidget#page6_mentes,
QWidget#widget {
    background: transparent;
}

QWidget#page4_harc {
    border-image: url("assets/dungeon_bg_blur.png") 0 0 0 0 stretch stretch;
}

/* --- 2. MATT KŐSZÜRKE-SZILVA RPG GOMBOK (LILA HOVER) --- */
QPushButton {
    background-color: #211e2b;
    border: 1px solid #524a66;
    border-bottom: 3px solid #100e17;
    border-radius: 6px;
    color: #e4e0d8;
    font-weight: bold;
    font-size: 14px;
    padding: 10px 18px;
    min-height: 26px;
    max-width: 280px;
}

QPushButton:hover {
    background-color: #2c273b;
    border: 1px solid #8c5ba6;
    border-bottom: 3px solid #513163;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #17151f;
    border: 1px solid #754a8c;
    border-bottom: 1px solid #754a8c;
    padding-top: 12px;
    padding-bottom: 8px;
}

QPushButton:disabled {
    background-color: #18161f;
    border: 1px solid #322d3d;
    color: #676373;
}

/* --- 3. OLDALSÁV ÉS HARCI KERETEK --- */
QFrame#frame_3 {
    background-color: rgba(18, 15, 25, 232);
    border: 1px solid #443d57;
    border-radius: 6px;
    padding: 8px;
}

QFrame#frame, QFrame#frame_2 {
    background-color: transparent;
    border: none;
}

/* --- 4. MINDEN LABEL MINDEN OLDALON (MATT SÖTÉT + LILA OUTLINE) --- */
QLabel {
    background-color: rgba(18, 16, 24, 235);
    border: 1px solid #754a8c;
    border-bottom: 2px solid #472a57;
    border-radius: 5px;
    color: #e4e0d8;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: bold;
}

QLabel#lbl_hos_img, QLabel#lbl_szorn_img {
    background-color: transparent;
    border: none;
}

/* --- 5. INVENTORY ÉS HARCI NAPLÓ --- */
QListWidget, QTextBrowser {
    background-color: rgba(14, 12, 20, 240);
    border: 1px solid #443d57;
    border-radius: 5px;
    color: #d6d2c9;
    font-size: 13px;
    padding: 6px;
}

QListWidget::item {
    background-color: #1f1b29;
    border: 1px solid #3a344a;
    border-radius: 4px;
}

QListWidget::item:hover {
    border: 1px solid #8c5ba6;
    background-color: #272233;
}

/* --- 6. BEJELENTKEZÉS, REGISZTRÁCIÓ ÉS MENTÉS KÁRTYÁK --- */
QWidget#page5_auth QFrame, QFrame#frame_mentes {
    background-color: rgba(17, 14, 24, 232);
    border: 1px solid #49415e;
    border-top: 3px solid #754a8c;
    border-radius: 6px;
    padding: 28px 36px;
}

QWidget#page5_auth QLabel, QLabel#lbl_mentes_cim, QLabel#lbl_mente_cim {
    color: #e6e2da;
    font-size: 22px;
    font-weight: bold;
    background: transparent;
    border: none;
    margin-bottom: 6px;
}

QLabel#lbl_mentes_info {
    background-color: rgba(12, 10, 18, 220);
    border: 1px solid #754a8c;
    border-radius: 5px;
    color: #d6d2c9;
    font-size: 13px;
    padding: 14px 18px;
    min-height: 68px;
    margin-bottom: 12px;
}

QWidget#page5_auth QLineEdit {
    background-color: #100e17;
    border: 1px solid #433b57;
    border-radius: 5px;
    color: #e6e2da;
    padding: 10px 12px;
    font-size: 14px;
    margin-bottom: 8px;
}

QWidget#page5_auth QLineEdit:focus {
    border: 1px solid #8c5ba6;
    background-color: #171421;
}

/* --- 7. POPUP ABLAK --- */
QDialog#glass_popup {
    background: transparent;
}

QDialog#glass_popup QFrame#glass_popup_keret {
    background-color: rgba(17, 14, 24, 245);
    border: 1px solid #524a66;
    border-top: 3px solid #754a8c;
    border-radius: 6px;
    padding: 22px 28px;
}

QDialog#glass_popup QLabel#popup_cim {
    color: #e6e2da;
    font-size: 18px;
    font-weight: bold;
}

QStackedWidget,
QWidget#page0_fomenu,
QWidget#page1_terkep,
QWidget#page2_soteterdo,
QWidget#page3_karakter,
QWidget#page4_harc,
QWidget#page6_beallitasok,
QWidget#widget {
    background: transparent;
    border: none;
    padding: 0px;
}

QDialog#glass_popup QLabel#popup_szoveg {
    color: #c2bdd0;
    font-size: 14px;
    background: transparent;
    border: none;
    padding: 4px 0px;
}


QFrame#frame_beallitasok {
    background-color: rgba(28, 26, 34, 235);
    border: 2px solid #4a4255;
    border-radius: 10px;
}

QFrame#frame_beallitasok QLabel {
    color: #f5eedc;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QLabel#lbl_beallitasok_cim {
    color: #c9a55c;
    font-size: 24px;
    font-weight: bold;
    padding-bottom: 6px;
}

QLabel#lbl_hangeffektek_ertek,
QLabel#lbl_hatterzene_ertek {
    color: #c9a55c;
    min-width: 42px;
}

QFrame#frame_beallitasok QSlider {
    min-height: 26px;
}

QFrame#frame_beallitasok QSlider::groove:horizontal {
    border: 1px solid #4a4255;
    height: 8px;
    background: #121116;
    border-radius: 4px;
}

QFrame#frame_beallitasok QSlider::sub-page:horizontal {
    background: #c9a55c;
    border: 1px solid #a88743;
    height: 8px;
    border-radius: 4px;
}

QFrame#frame_beallitasok QSlider::handle:horizontal {
    background: #f5eedc;
    border: 2px solid #4a4255;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QFrame#frame_beallitasok QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #c9a55c;
}